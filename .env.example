# Copy this file to .env for local scripts. Never commit .env.

# Optional admin settings (also set as Firebase Functions env vars).
# ADMIN_UIDS=firebase-uid-1,firebase-uid-2

# CueLinks Publisher API (server-side only — never expose this key in the browser).
# Set the deployed secret with: firebase functions:secrets:set CUELINKS_API_KEY
CUELINKS_API_KEY=your-cuelinks-api-key

# Shared secret for the Cuelinks Global Postback webhook.
CUELINKS_WEBHOOK_SECRET=choose-a-long-random-secret

# Optional CueLinks wallet settings.
CUELINKS_USER_SHARE_RATE=0.5
CUELINKS_CREDIT_DAYS=45
CUELINKS_LOOKBACK_DAYS=120

# CJ Affiliate APIs (server-side only — never expose this token in the browser).
# Create a Personal Access Token at https://developers.cj.com/account/personal-access-tokens
CJ_ACCESS_TOKEN=your-cj-personal-access-token
# Company ID (CID) shown in the CJ dashboard account menu.
CJ_COMPANY_ID=your-cj-company-id
# Website ID / PID for munafaduniya.com (CJ Account > Websites).
CJ_WEBSITE_ID=your-cj-website-id

# AliExpress Open Platform / Affiliate API (server-side only).
# Create an app at https://openservice.aliexpress.com/ and copy its key and secret.
ALIEXPRESS_APP_KEY=your-aliexpress-app-key
ALIEXPRESS_APP_SECRET=your-aliexpress-app-secret
# Affiliate tracking ID created in the AliExpress affiliate dashboard.
ALIEXPRESS_TRACKING_ID=your-aliexpress-tracking-id
# Optional: comma-separated search terms used to build data/aliexpress-products.json.
ALIEXPRESS_KEYWORDS=wireless earbuds,smartwatch,home gadgets,kitchen tools
ALIEXPRESS_TARGET_CURRENCY=INR
ALIEXPRESS_TARGET_LANGUAGE=EN
ALIEXPRESS_SHIP_TO_COUNTRY=IN
ALIEXPRESS_SIGN_METHOD=md5
# OAuth code for scripts/get-aliexpress-token.mjs (valid for a few minutes).
ALIEXPRESS_AUTH_CODE=your-aliexpress-oauth-code
# Optional OAuth token for AliExpress APIs that require authorization.
ALIEXPRESS_ACCESS_TOKEN=your-aliexpress-access-token
