# Copy to .env.munafaduniya-68695 for deployed Functions settings.
# Never put FLIPKART_AFFILIATE_ID, FLIPKART_AFFILIATE_TOKEN, or
# CUELINKS_API_KEY here; use `firebase functions:secrets:set` for those.
FLIPKART_USER_SHARE_RATE=0.5
FLIPKART_CREDIT_DAYS=45
REPORT_LOOKBACK_DAYS=120
ADMIN_UIDS=

# CUELINKS_API_KEY is a Functions secret. For local scripts, export it or add
# it to a gitignored .env file. Never commit the key.
# CUELINKS_API_KEY=

# Shared secret for the Cuelinks Global Postback webhook.
CUELINKS_WEBHOOK_SECRET=choose-a-long-random-secret

# Optional CueLinks wallet settings.
CUELINKS_USER_SHARE_RATE=0.5
CUELINKS_CREDIT_DAYS=45
CUELINKS_LOOKBACK_DAYS=120
